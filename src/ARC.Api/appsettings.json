{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ArcApi": {
    "DefaultRunMode": "Shadow",
    "JwtAuthority": "",
    "JwtAudience": ""
  },
  "ArcAi": {
    "Provider": "Shadow",
    "Endpoint": "",
    "UseManagedIdentity": true,
    "NarrationEnabled": true,
    "MaxOutputTokens": 400,
    "CheapNarration": { "Deployment": "" },
    "Reasoning": { "Deployment": "" },
    "Extraction": { "Deployment": "" }
  },
  "ArcGuardrails": {
    "FailOpen": false,
    "Backend": "Local"
  },
  "ArcKnowledge": {
    "RagEnabled": true,
    "VectorSearchEnabled": true,
    "LexicalSearchEnabled": true,
    "RetrievalMode": "Hybrid",
    "MaxRetrievalTopK": 8,
    "MaxPromptChunks": 4,
    "MaxSnippetCharacters": 400,
    "PublishedPolicyVersion": "current",
    "Embeddings": {
      "Provider": "None",
      "Endpoint": "",
      "Deployment": "",
      "Dimensions": 3072,
      "UseManagedIdentity": true
    }
  },
  "ArcData": {
    "Sql": {
      "ConnectionString": "",
      "UseManagedIdentity": true
    },
    "Cosmos": {
      "AccountEndpoint": "",
      "UseManagedIdentity": true
    },
    "ServiceBus": {
      "FullyQualifiedNamespace": "",
      "UseManagedIdentity": true
    }
  }
}
